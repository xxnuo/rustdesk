FROM linuxserver/webtop:ubuntu-xfce-version-4e5d70f4

ARG DEBIAN_FRONTEND=noninteractive
ARG RUST_VERSION=1.75
ARG FLUTTER_VERSION=3.24.5
ARG VCPKG_COMMIT_ID=120deac3062162151622ca4860575a33844ba10b
ARG FLUTTER_RUST_BRIDGE_VERSION=1.80.1
ARG CARGO_EXPAND_VERSION=1.0.95

ENV VCPKG_ROOT=/opt/artifacts/vcpkg
ENV VCPKG_FORCE_SYSTEM_BINARIES=1
ENV VCPKG_DEFAULT_TRIPLET=x64-linux
ENV VCPKG_DEFAULT_HOST_TRIPLET=x64-linux
ENV PATH=/opt/flutter/bin:/opt/rust/cargo/bin:${PATH}
ENV CARGO_HOME=/opt/rust/cargo
ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_INCREMENTAL=0
ENV DISPLAY=:1

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        dbus-x11 \
        file \
        gcc \
        g++ \
        git \
        libayatana-appindicator3-dev \
        libasound2-dev \
        libclang-dev \
        libtool \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libgtk-3-dev \
        libpam0g-dev \
        libpulse-dev \
        libssl-dev \
        libva-dev \
        libxcb-randr0-dev \
        libxcb-shape0-dev \
        libxcb-xfixes0-dev \
        libxdo-dev \
        libxfixes-dev \
        llvm-dev \
        make \
        nasm \
        ninja-build \
        perl \
        pkg-config \
        python3 \
        rpm \
        sudo \
        tar \
        tree \
        unzip \
        wget \
        xz-utils \
        zip && \
    apt-get install -y zip unzip tar && \
    command -v curl && \
    command -v zip && \
    command -v unzip && \
    command -v tar && \
    (apt-get remove -y libopus-dev || true) && \
    rm -rf /var/lib/apt/lists/*

COPY vcpkg.json /workspace-src/vcpkg.json
COPY res/vcpkg /workspace-src/res/vcpkg
COPY .github/patches/flutter_3.24.4_dropdown_menu_enableFilter.diff /tmp/flutter_3.24.4_dropdown_menu_enableFilter.diff

RUN git clone https://github.com/microsoft/vcpkg "${VCPKG_ROOT}" && \
    cd "${VCPKG_ROOT}" && \
    git reset --hard "${VCPKG_COMMIT_ID}" && \
    ./bootstrap-vcpkg.sh -disableMetrics && \
    cd /workspace-src && \
    sed -i 's/set(aom_target_cpu "")/set(aom_target_cpu "-DAOM_TARGET_CPU=generic")/' res/vcpkg/aom/portfile.cmake && \
    ("${VCPKG_ROOT}/vcpkg" install --triplet x64-linux --x-install-root="${VCPKG_ROOT}/installed" || \
        (find "${VCPKG_ROOT}/buildtrees" -maxdepth 2 -name "*.log" -print -exec sh -c 'echo "===== $1"; tail -n 80 "$1"' sh {} \; && false))

RUN wget -O /tmp/rustup-init https://sh.rustup.rs && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y --default-toolchain "${RUST_VERSION}" --profile minimal --component rustfmt && \
    rm /tmp/rustup-init && \
    rustup target add x86_64-unknown-linux-gnu && \
    cargo install cargo-expand --version "${CARGO_EXPAND_VERSION}" --locked && \
    cargo install flutter_rust_bridge_codegen --version "${FLUTTER_RUST_BRIDGE_VERSION}" --features uuid --locked

RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

RUN wget -O /tmp/flutter.tar.xz "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" && \
    tar -xf /tmp/flutter.tar.xz -C /opt && \
    rm /tmp/flutter.tar.xz && \
    git config --global --add safe.directory /opt/flutter && \
    git config --global --add safe.directory "*" && \
    if [ "${FLUTTER_VERSION}" = "3.24.5" ]; then cd /opt/flutter && git apply /tmp/flutter_3.24.4_dropdown_menu_enableFilter.diff; fi && \
    rm /tmp/flutter_3.24.4_dropdown_menu_enableFilter.diff && \
    flutter doctor -v && \
    flutter config --enable-linux-desktop && \
    flutter precache --linux

COPY dev/rustdesk-dev.sh /usr/local/bin/rustdesk-dev
RUN chmod +x /usr/local/bin/rustdesk-dev && \
    mkdir -p /workspace /config/log && \
    chown -R abc:abc /workspace /config /opt/artifacts /opt/rust /opt/flutter

WORKDIR /workspace
